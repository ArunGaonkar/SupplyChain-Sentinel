<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>SupplyChain Sentinel — Pharma Alert Cards</title>
<style>
  :root {
    --bg: #f8fafc;
    --card-bg: #ffffff;
    --border: #e2e8f0;
    --text: #0f172a;
    --muted: #64748b;
    --high: #dc2626;
    --high-bg: #fef2f2;
    --medium: #d97706;
    --medium-bg: #fffbeb;
    --low: #16a34a;
    --low-bg: #f0fdf4;
    --accent: #2563eb;
    --gap: #7c3aed;
    --gap-bg: #f5f3ff;
    --node-event: #eff6ff;
    --node-event-border: #93c5fd;
    --node-scope: #f8fafc;
    --node-scope-border: #cbd5e1;
    --node-country: #f0fdf4;
    --node-country-border: #86efac;
    --node-company: #fef3c7;
    --node-company-border: #fcd34d;
  }
  * { box-sizing: border-box; }
  body {
    margin: 0;
    background: var(--bg);
    color: var(--text);
    font-family: -apple-system, "Segoe UI", Inter, system-ui, sans-serif;
    line-height: 1.5;
  }
  header {
    background: linear-gradient(135deg, #0f172a, #1e293b);
    color: #fff;
    padding: 32px 24px;
  }
  header h1 { margin: 0 0 6px; font-size: 26px; }
  header p { margin: 0; color: #cbd5e1; max-width: 780px; }
  .stats {
    display: flex;
    gap: 20px;
    margin-top: 20px;
    flex-wrap: wrap;
  }
  .stat { background: rgba(255,255,255,0.08); border-radius: 10px; padding: 10px 16px; min-width: 110px; }
  .stat .n { font-size: 22px; font-weight: 700; }
  .stat .l { font-size: 12px; color: #94a3b8; text-transform: uppercase; letter-spacing: 0.04em; }

  main { max-width: 1180px; margin: 0 auto; padding: 32px 24px 80px; }
  section { margin-bottom: 40px; }
  h2 { font-size: 18px; margin: 0 0 12px; }
  .section-head { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 12px; margin-bottom: 12px; }

  /* --- controls bar --- */
  .controls {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    align-items: center;
    background: var(--card-bg);
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: 12px 16px;
    margin-bottom: 20px;
  }
  .control { display: flex; flex-direction: column; gap: 3px; }
  .control label { font-size: 11px; color: var(--muted); text-transform: uppercase; letter-spacing: 0.03em; }
  .control select {
    font-size: 13px;
    padding: 6px 10px;
    border-radius: 6px;
    border: 1px solid var(--border);
    background: #fff;
    color: var(--text);
    min-width: 150px;
  }
  .filter-chip {
    margin-left: auto;
    display: none;
    align-items: center;
    gap: 8px;
    font-size: 13px;
    background: #eff6ff;
    color: var(--accent);
    border-radius: 999px;
    padding: 6px 12px;
  }
  .filter-chip.visible { display: flex; }
  .filter-chip button {
    border: none;
    background: var(--accent);
    color: #fff;
    border-radius: 999px;
    width: 18px;
    height: 18px;
    line-height: 1;
    cursor: pointer;
    font-size: 12px;
  }

  /* --- graph --- */
  .diagram-wrap {
    background: var(--card-bg);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 16px;
    overflow-x: auto;
    position: relative;
  }
  .diagram-wrap svg { display: block; min-width: 700px; }
  .graph-toolbar { display: flex; gap: 8px; align-items: center; margin-bottom: 10px; flex-wrap: wrap; }
  .toggle-btn {
    font-size: 12px;
    padding: 6px 12px;
    border-radius: 6px;
    border: 1px solid var(--border);
    background: #fff;
    cursor: pointer;
    color: var(--text);
  }
  .toggle-btn.active { background: var(--accent); color: #fff; border-color: var(--accent); }
  .graph-hint { font-size: 12px; color: var(--muted); }
  .legend { display: flex; gap: 14px; flex-wrap: wrap; font-size: 11px; color: var(--muted); margin-top: 8px; }
  .legend span { display: inline-flex; align-items: center; gap: 5px; }
  .legend i { width: 10px; height: 10px; border-radius: 3px; display: inline-block; }

  .gnode rect { cursor: pointer; transition: opacity 0.15s; }
  .gnode text { pointer-events: none; }
  .gnode.dimmed { opacity: 0.25; }
  .gnode.focused rect { stroke-width: 2.5; }
  .gedge { transition: opacity 0.15s, stroke-width 0.15s; }
  .gedge.dimmed { opacity: 0.12; }
  .gedge.active { stroke: var(--accent); stroke-width: 2.5; opacity: 1; }
  .empty-graph { color: var(--muted); font-style: italic; padding: 20px; }

  /* --- alert / gap cards --- */
  .card {
    background: var(--card-bg);
    border: 1px solid var(--border);
    border-left-width: 5px;
    border-radius: 10px;
    padding: 18px 20px;
    margin-bottom: 16px;
  }
  .card.high { border-left-color: var(--high); }
  .card.medium { border-left-color: var(--medium); }
  .card.low { border-left-color: var(--low); }
  .card.gap-card { border-left-color: var(--gap); border-left-style: dashed; }
  .card.hidden-by-filter { display: none; }

  .card-head { display: flex; justify-content: space-between; align-items: flex-start; gap: 16px; }
  .card-head h3 { margin: 0; font-size: 16px; flex: 1; }
  .badge {
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.03em;
    padding: 3px 10px;
    border-radius: 999px;
    white-space: nowrap;
  }
  .badge.high { background: var(--high-bg); color: var(--high); }
  .badge.medium { background: var(--medium-bg); color: var(--medium); }
  .badge.low { background: var(--low-bg); color: var(--low); }
  .badge.gap { background: var(--gap-bg); color: var(--gap); }

  .card p.explanation, .card p.gap-note { color: #334155; margin: 12px 0; font-size: 14px; }
  .card p.gap-note { font-style: italic; color: var(--muted); }

  .sources { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 10px; }
  .sources a {
    font-size: 12px;
    color: var(--accent);
    text-decoration: none;
    background: #eff6ff;
    border-radius: 6px;
    padding: 4px 10px;
  }
  .sources a:hover { text-decoration: underline; }

  .approve {
    margin-top: 14px;
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 13px;
    color: var(--muted);
    border-top: 1px dashed var(--border);
    padding-top: 12px;
  }
  .approve input { width: 16px; height: 16px; }

  .empty { color: var(--muted); font-style: italic; }
  .no-match { color: var(--muted); font-style: italic; display: none; padding: 12px 0; }
  .no-match.visible { display: block; }

  footer {
    max-width: 1180px;
    margin: 0 auto;
    padding: 24px;
    color: var(--muted);
    font-size: 12px;
    border-top: 1px solid var(--border);
  }
  footer a { color: var(--accent); }
</style>
</head>
<body>

<header>
  <h1>SupplyChain Sentinel</h1>
  <p>Pharma trade &amp; tariff causality — cited, explainable Alert Cards connecting policy/news events to SEC filing disclosures via a shared entity graph.</p>
  <div class="stats">
    <div class="stat"><div class="n">{{ stats.policy_events }}</div><div class="l">Policy Events</div></div>
    <div class="stat"><div class="n">{{ stats.filing_mentions }}</div><div class="l">Filing Mentions</div></div>
    <div class="stat"><div class="n">{{ stats.graph_links }}</div><div class="l">Graph Links</div></div>
    <div class="stat"><div class="n">{{ stats.alert_cards }}</div><div class="l">Alert Cards</div></div>
    <div class="stat"><div class="n">{{ stats.gap_mentions }}</div><div class="l">Gap Signals</div></div>
  </div>
</header>

<main>
  <div class="controls">
    <div class="control">
      <label for="segment-select">Segment</label>
      <select id="segment-select">
        <option value="pharma">Pharma</option>
        <option value="textile" disabled>Textile (coming soon)</option>
        <option value="semiconductor" disabled>Semiconductor (coming soon)</option>
      </select>
    </div>
    <div class="control">
      <label for="time-select">Time range</label>
      <select id="time-select">
        <option value="all" selected>All time</option>
        <option value="90">Last 90 days</option>
        <option value="30">Last 30 days</option>
        <option value="ytd">Since 2026-01-01</option>
      </select>
    </div>
    <div class="filter-chip" id="filter-chip">
      <span id="filter-chip-label"></span>
      <button id="filter-chip-clear" title="Clear filter">✕</button>
    </div>
  </div>

  <section>
    <div class="section-head">
      <h2>Dependency graph</h2>
    </div>
    <div class="diagram-wrap">
      <div class="graph-toolbar">
        <button class="toggle-btn" id="btn-simplified">Simplified (catalyst → country → company)</button>
        <button class="toggle-btn active" id="btn-detailed">Detailed (+ policy scope)</button>
        <span class="graph-hint">Hover a node to trace its connections · click to filter Alert Cards below · click empty space to clear</span>
      </div>
      <div id="graph-container"><p class="empty-graph">Loading graph…</p></div>
      <div class="legend">
        <span><i style="background:var(--node-event-border)"></i>Catalyst (policy headline)</span>
        <span><i style="background:var(--node-scope-border)"></i>Policy scope (detailed view only)</span>
        <span><i style="background:var(--node-country-border)"></i>Shared country</span>
        <span><i style="background:var(--node-company-border)"></i>Company (10-K filer)</span>
      </div>
    </div>
  </section>

  <section>
    <div class="section-head">
      <h2>Alert Cards</h2>
    </div>
    {% if not cards %}
      <p class="empty">No alerts yet — run src/alerts.py.</p>
    {% endif %}
    {% for card in cards %}
      <div class="card {{ card.severity }}" data-kind="alert" data-date="{{ card.date_iso }}" data-ticker="{{ card.filing_mention.ticker }}" data-country="{{ card.shared_country }}" data-event-id="{{ card.policy_event_id }}" data-mention-id="{{ card.filing_mention_id }}">
        <div class="card-head">
          <h3>{{ card.title }}</h3>
          <span class="badge {{ card.severity }}">{{ card.severity }}</span>
        </div>
        <p class="explanation">{{ card.explanation }}</p>
        <div class="sources">
          <a href="{{ card.policy_source_url }}" target="_blank" rel="noopener">Policy source: {{ card.policy_event.headline }}</a>
          <a href="{{ card.filing_source_url }}" target="_blank" rel="noopener">Filing source: {{ card.filing_mention.company }} {{ card.filing_mention.filing_type }}</a>
        </div>
        <label class="approve">
          <input type="checkbox" class="approve-checkbox" data-alert-id="{{ card.id }}">
          Reviewed by analyst (stored locally in this browser only — a stand-in for a full human-approval workflow; see README)
        </label>
      </div>
    {% endfor %}
    <p class="no-match" id="alert-no-match">No Alert Cards match the current filter.</p>
  </section>

  <section>
    <div class="section-head">
      <h2>Gap / Opportunity signals</h2>
    </div>
    <p class="graph-hint" style="margin-bottom: 12px;">Companies whose own SEC filings disclose a real country/commodity dependency, but for which no matching policy event exists in this run's data — nothing to graph yet, but worth watching. See CHANGELOG.md for why this is a real, documented limitation rather than a filtering failure.</p>
    {% if not gap_mentions %}
      <p class="empty">No gap signals — every disclosed dependency this run matched a policy event.</p>
    {% endif %}
    {% for m in gap_mentions %}
      <div class="card gap-card" data-kind="gap" data-date="{{ m.date_iso }}" data-ticker="{{ m.ticker }}" data-country="{{ m.country }}">
        <div class="card-head">
          <h3>{{ m.company }} ({{ m.ticker }}) — {{ m.country }} / {{ m.commodity }}</h3>
          <span class="badge gap">gap</span>
        </div>
        <p class="gap-note">"{{ m.risk_text }}" — disclosed in {{ m.filing_type }} filed {{ m.date_iso }}, but no policy event in this data pull names {{ m.country }} for {{ m.commodity }}.</p>
        <div class="sources">
          <a href="{{ m.source_url }}" target="_blank" rel="noopener">Filing source: {{ m.company }} {{ m.filing_type }}</a>
        </div>
      </div>
    {% endfor %}
    <p class="no-match" id="gap-no-match">No gap signals match the current filter.</p>
  </section>
</main>

<footer>
  Built with a two-agent pipeline (Policy Agent + Filing Agent) + causal graph merge, coded with Claude Code.
  See <a href="../CHANGELOG.md">CHANGELOG.md</a> for the baseline-vs-advanced comparison and <a href="../REPRODUCTION.md">REPRODUCTION.md</a> to rerun from cached data.
</footer>

<script id="graph-data" type="application/json">{{ graph_data_json | safe }}</script>
<script>
(function () {
  "use strict";
  var DATA = JSON.parse(document.getElementById("graph-data").textContent);
  var eventsById = {};
  DATA.events.forEach(function (e) { eventsById[e.id] = e; });
  var mentionsById = {};
  DATA.mentions.forEach(function (m) { mentionsById[m.id] = m; });

  var state = { detail: "detailed", timeRange: "all", focus: null };

  // ---------- checkbox persistence (unchanged from v1) ----------
  document.querySelectorAll(".approve-checkbox").forEach(function (box) {
    var key = "scs-approved-" + box.dataset.alertId;
    try { box.checked = localStorage.getItem(key) === "1"; } catch (e) {}
    box.addEventListener("change", function () {
      try { localStorage.setItem(key, box.checked ? "1" : "0"); } catch (e) {}
    });
  });

  // ---------- time range ----------
  function cutoffDate(range) {
    if (range === "all") return null;
    if (range === "ytd") return new Date("2026-01-01T00:00:00");
    var days = parseInt(range, 10);
    var d = new Date();
    d.setDate(d.getDate() - days);
    return d;
  }

  function withinRange(dateStr, range) {
    var cutoff = cutoffDate(range);
    if (!cutoff || !dateStr) return true;
    var d = new Date(dateStr + "T00:00:00");
    return d >= cutoff;
  }

  // ---------- graph rendering ----------
  function visibleLinks() {
    return DATA.links.filter(function (link) {
      var event = eventsById[link.event_id];
      return event && withinRange(event.date, state.timeRange);
    });
  }

  function esc(s) {
    return String(s == null ? "" : s).replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;");
  }

  function truncate(s, n) {
    s = String(s || "");
    return s.length > n ? s.slice(0, n - 1) + "…" : s;
  }

  function renderGraph() {
    var links = visibleLinks();
    var container = document.getElementById("graph-container");
    if (!links.length) {
      container.innerHTML = '<p class="empty-graph">No graph links in the selected time range.</p>';
      return;
    }

    var detailed = state.detail === "detailed";
    var eventNodes = [], scopeNodes = [], countryNodes = [], companyNodes = [];
    var seenEvent = {}, seenScope = {}, seenCountry = {}, seenCompany = {};

    // Edges are keyed by "from|to" so a repeated edge (e.g. many companies
    // sharing one country's scope->country hop) is drawn once, but we still
    // track EVERY link.id that produced it — that's what lets highlighting
    // trace one company's exact path back to its catalyst without leaking
    // into sibling companies that merely pass through the same shared hub
    // (see highlight() below).
    var edgesByKey = {};
    function addEdge(from, to, linkId) {
      var key = from + ">" + to;
      var edge = edgesByKey[key];
      if (!edge) { edge = { from: from, to: to, linkIds: {} }; edgesByKey[key] = edge; }
      edge.linkIds[linkId] = true;
      return edge;
    }

    links.forEach(function (link) {
      var event = eventsById[link.event_id];
      var mention = mentionsById[link.mention_id];
      if (!event || !mention) return;
      var country = link.shared_country || mention.country;

      if (!seenEvent[event.id]) { seenEvent[event.id] = true; eventNodes.push(event.id); }
      if (!seenCountry[country]) { seenCountry[country] = true; countryNodes.push(country); }
      if (!seenCompany[mention.ticker]) { seenCompany[mention.ticker] = true; companyNodes.push(mention.ticker); }

      if (detailed) {
        var scopeId = "scope:" + event.id;
        if (!seenScope[scopeId]) { seenScope[scopeId] = true; scopeNodes.push(event.id); }
        addEdge("event:" + event.id, "scope:" + event.id, link.id);
        addEdge("scope:" + event.id, "country:" + country, link.id);
      } else {
        addEdge("event:" + event.id, "country:" + country, link.id);
      }
      addEdge("country:" + country, "company:" + mention.ticker, link.id);
    });

    var allEdgesList = Object.keys(edgesByKey).map(function (k) { return edgesByKey[k]; });

    var columns = detailed
      ? [
          { key: "event", ids: eventNodes, cls: "node-event" },
          { key: "scope", ids: scopeNodes, cls: "node-scope" },
          { key: "country", ids: countryNodes, cls: "node-country" },
          { key: "company", ids: companyNodes, cls: "node-company" },
        ]
      : [
          { key: "event", ids: eventNodes, cls: "node-event" },
          { key: "country", ids: countryNodes, cls: "node-country" },
          { key: "company", ids: companyNodes, cls: "node-company" },
        ];

    var nodeW = 230, nodeH = 50, rowH = 68, topPad = 30, colGap = 90;
    var colX = [30];
    for (var i = 1; i < columns.length; i++) colX.push(colX[i - 1] + nodeW + colGap);
    var maxRows = Math.max.apply(null, columns.map(function (c) { return c.ids.length; }).concat([1]));
    var width = colX[colX.length - 1] + nodeW + 30;
    var height = topPad * 2 + rowH * maxRows;

    var positions = {}; // nodeKey -> {x, y}
    columns.forEach(function (col, ci) {
      col.ids.forEach(function (id, ri) {
        var key = col.key + ":" + id;
        positions[key] = { x: colX[ci], y: topPad + rowH * ri + rowH / 2, col: ci };
      });
    });

    var svgParts = ['<svg viewBox="0 0 ' + width + ' ' + height + '" xmlns="http://www.w3.org/2000/svg" font-family="Inter, system-ui, sans-serif" font-size="13">'];

    allEdgesList.forEach(function (edge, idx) {
      var a = positions[edge.from], b = positions[edge.to];
      if (!a || !b) return;
      var x1 = a.x + nodeW, y1 = a.y, x2 = b.x, y2 = b.y;
      var mx = (x1 + x2) / 2;
      svgParts.push(
        '<path class="gedge" data-from="' + esc(edge.from) + '" data-to="' + esc(edge.to) + '" d="M' + x1 + ',' + y1 +
        ' C' + mx + ',' + y1 + ' ' + mx + ',' + y2 + ' ' + x2 + ',' + y2 +
        '" stroke="#94a3b8" stroke-width="1.5" fill="none" opacity="0.7"/>'
      );
    });

    function nodeLabelSub(colKey, id) {
      if (colKey === "event") { var e = eventsById[id]; return { label: truncate(e.headline, 30), sub: e.date, title: e.headline + " — " + e.country + " / " + e.commodity + " (" + e.date + ", " + e.severity + ")\n" + e.source_url }; }
      if (colKey === "scope") { var e2 = eventsById[id]; return { label: truncate(e2.country, 26), sub: truncate(e2.commodity, 30), title: e2.country + " / " + e2.commodity }; }
      if (colKey === "country") { return { label: id, sub: "shared country", title: id }; }
      var m = DATA.mentions.filter(function (x) { return x.ticker === id; })[0];
      return { label: id, sub: "10-K filer", title: (m ? m.company : id) + " — " + id };
    }

    columns.forEach(function (col) {
      col.ids.forEach(function (id) {
        var key = col.key + ":" + id;
        var pos = positions[key];
        var info = nodeLabelSub(col.key, id);
        var focused = state.focus === key;
        svgParts.push(
          '<g class="gnode ' + (focused ? "focused" : "") + '" data-node="' + esc(key) + '" tabindex="0">' +
            '<title>' + esc(info.title) + '</title>' +
            '<rect x="' + pos.x + '" y="' + (pos.y - nodeH / 2) + '" width="' + nodeW + '" height="' + nodeH + '" rx="8" class="' + col.cls + '" fill="var(--' + col.cls + ')" stroke="var(--' + col.cls + '-border)"/>' +
            '<text x="' + (pos.x + 12) + '" y="' + (pos.y - 3) + '" fill="#0f172a" font-weight="600">' + esc(info.label) + '</text>' +
            '<text x="' + (pos.x + 12) + '" y="' + (pos.y + 14) + '" fill="#475569" font-size="11">' + esc(info.sub) + '</text>' +
          '</g>'
        );
      });
    });

    svgParts.push("</svg>");
    container.innerHTML = svgParts.join("");

    // ---- interactivity: hover highlight ----
    var svg = container.querySelector("svg");
    var nodeEls = svg.querySelectorAll(".gnode");
    var edgeEls = svg.querySelectorAll(".gedge");

    function clearHighlight() {
      nodeEls.forEach(function (n) { n.classList.remove("dimmed"); });
      edgeEls.forEach(function (e) { e.classList.remove("dimmed", "active"); });
    }

    // Which of the currently-visible links actually involve this node?
    // Used (not a plain graph BFS) so that clicking a company traces its
    // exact path back to its catalyst without leaking into sibling
    // companies that merely happen to pass through the same shared country
    // hub — a plain "everything reachable" traversal would light up every
    // other company sharing that country too, which isn't what "trace this
    // company's connections" should mean.
    function relevantLinkIds(nodeKey) {
      var parts = nodeKey.split(":");
      var type = parts[0], id = parts.slice(1).join(":");
      var relevant = {};
      links.forEach(function (link) {
        var event = eventsById[link.event_id];
        var mention = mentionsById[link.mention_id];
        if (!event || !mention) return;
        var country = link.shared_country || mention.country;
        var match =
          (type === "company" && mention.ticker === id) ||
          (type === "country" && country === id) ||
          ((type === "event" || type === "scope") && event.id === id);
        if (match) relevant[link.id] = true;
      });
      return relevant;
    }

    function highlight(startKey) {
      var relevant = relevantLinkIds(startKey);
      var connectedNodes = {};
      var connectedEdges = {};
      connectedNodes[startKey] = true;
      allEdgesList.forEach(function (edge, idx) {
        var hit = Object.keys(edge.linkIds).some(function (lid) { return relevant[lid]; });
        if (hit) {
          connectedEdges[idx] = true;
          connectedNodes[edge.from] = true;
          connectedNodes[edge.to] = true;
        }
      });
      nodeEls.forEach(function (n) {
        n.classList.toggle("dimmed", !connectedNodes[n.dataset.node]);
      });
      edgeEls.forEach(function (e, idx) {
        var isActive = !!connectedEdges[idx];
        e.classList.toggle("active", isActive);
        e.classList.toggle("dimmed", !isActive);
      });
    }

    nodeEls.forEach(function (n) {
      n.addEventListener("mouseenter", function () { if (!state.focus) highlight(n.dataset.node); });
      n.addEventListener("mouseleave", function () { if (!state.focus) clearHighlight(); });
      n.addEventListener("click", function (ev) {
        ev.stopPropagation();
        var key = n.dataset.node;
        state.focus = state.focus === key ? null : key;
        renderGraph();
        applyCardFilters();
      });
    });
    svg.addEventListener("click", function () {
      if (state.focus) { state.focus = null; renderGraph(); applyCardFilters(); }
    });

    if (state.focus) highlight(state.focus);
  }

  // ---------- card filtering (Alert Cards + Gap section) ----------
  function focusMatches(el) {
    if (!state.focus) return true;
    var parts = state.focus.split(":");
    var type = parts[0], id = parts.slice(1).join(":");
    if (type === "company") return el.dataset.ticker === id;
    if (type === "country") return el.dataset.country === id;
    if (type === "event" || type === "scope") return el.dataset.eventId === id; // gap cards have no event id, so they never match
    return true;
  }

  function updateFilterChip() {
    var chip = document.getElementById("filter-chip");
    var label = document.getElementById("filter-chip-label");
    if (state.focus) {
      var parts = state.focus.split(":");
      var type = parts[0], id = parts.slice(1).join(":");
      var text = id;
      if (type === "event" || type === "scope") text = eventsById[id] ? eventsById[id].headline : id;
      chip.classList.add("visible");
      label.textContent = "Filtering by: " + text;
    } else {
      chip.classList.remove("visible");
    }
  }

  function applyCardFilters() {
    var anyAlertVisible = false, anyGapVisible = false;
    document.querySelectorAll('.card[data-kind="alert"]').forEach(function (card) {
      var visible = withinRange(card.dataset.date, state.timeRange) && focusMatches(card);
      card.classList.toggle("hidden-by-filter", !visible);
      if (visible) anyAlertVisible = true;
    });
    document.querySelectorAll('.card[data-kind="gap"]').forEach(function (card) {
      var visible = withinRange(card.dataset.date, state.timeRange) && focusMatches(card);
      card.classList.toggle("hidden-by-filter", !visible);
      if (visible) anyGapVisible = true;
    });
    document.getElementById("alert-no-match").classList.toggle("visible", !anyAlertVisible && document.querySelectorAll('.card[data-kind="alert"]').length > 0);
    document.getElementById("gap-no-match").classList.toggle("visible", !anyGapVisible && document.querySelectorAll('.card[data-kind="gap"]').length > 0);
    updateFilterChip();
  }

  // ---------- wiring ----------
  document.getElementById("btn-detailed").addEventListener("click", function () {
    state.detail = "detailed";
    this.classList.add("active");
    document.getElementById("btn-simplified").classList.remove("active");
    renderGraph();
  });
  document.getElementById("btn-simplified").addEventListener("click", function () {
    state.detail = "simplified";
    this.classList.add("active");
    document.getElementById("btn-detailed").classList.remove("active");
    renderGraph();
  });
  document.getElementById("time-select").addEventListener("change", function () {
    state.timeRange = this.value;
    renderGraph();
    applyCardFilters();
  });
  document.getElementById("filter-chip-clear").addEventListener("click", function () {
    state.focus = null;
    renderGraph();
    applyCardFilters();
  });
  // Segment dropdown: only "pharma" is implemented this round, so it's a
  // no-op — present so the control surface is ready as more segments ship.
  document.getElementById("segment-select").addEventListener("change", function () {});

  renderGraph();
  applyCardFilters();
})();
</script>

</body>
</html>
